{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Current Example",
            "type": "cppdbg",
            "request": "launch",
            // This starts at your active file's folder (src), goes up one level, then down into build
            "program": "${fileDirname}/../build/hw_5_2",
            "args": [
                "${workspaceFolder}/sample_input/hw_5_2/H2.json"
            ],
            "stopAtEntry": false,
            // Sets the working directory to the root of the specific example folder
            "cwd": "${fileDirname}/..",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}